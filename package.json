    "lucide-react": "^1.77.0",
    "next": "^15.5.29",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "swr": "^2.5.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.7.0",
