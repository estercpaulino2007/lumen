# Clave maestra (64 hex). Deriva cifrado AES-256-GCM en reposo, firma de enlaces y seudónimos.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LUMEN_MASTER_KEY=
# Opcional: Valkey/Redis para OTP, rate limiting y fila (si no, se usa memoria del proceso)
VALKEY_URL=
# Modo demo: habilita botón "Cargar datos de demostración" y muestra OTP simulado en la Central de Notificaciones
LUMEN_DEMO_MODE=true
# IA generativa opcional para Luminy (si no hay clave, Luminy funciona solo con reglas):
# ANTHROPIC_API_KEY=...            (modelo por defecto: claude-haiku-5-5; cambia con LUMINY_MODEL)
# o cualquier API compatible con OpenAI (OpenAI, Groq, OpenRouter…):
# LUMINY_API_KEY=...
# LUMINY_BASE_URL=https://api.groq.com/openai/v1
# LUMINY_MODEL=llama-3.3-70b-versatile
